# Copy to .env.local and fill in. EXPO_PUBLIC_* values are bundled into the app
# and are not secrets.

# Worker URL. For a phone on the same network use the machine's LAN or Tailscale address.
EXPO_PUBLIC_API_URL=http://localhost:8787

# Google OAuth client IDs (Google Cloud console → Credentials).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=

# Shows "Continue with dev account" on the sign-in screen. Only works when the
# Worker runs with ALLOW_DEV_LOGIN=true. Never enable for a release build.
EXPO_PUBLIC_DEV_LOGIN=false

# Used by app.config.ts at build time.
APP_BUNDLE_ID=com.leo.autumndashboard
GOOGLE_IOS_URL_SCHEME=com.googleusercontent.apps.replace-me
EAS_PROJECT_ID=
